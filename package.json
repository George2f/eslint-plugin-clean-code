{
  "name": "@george2f/eslint-plugin-clean-code",
  "version": "0.4.0",
  "description": "ESLint rules derived from the book Clean Code (Robert C. Martin)",
  "type": "module",
  "license": "MIT",
  "author": "Juraj Pejnovic",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "clean-code",
    "robert-c-martin",
    "lint"
  ],
  "homepage": "https://github.com/George2f/eslint-plugin-clean-code#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/George2f/eslint-plugin-clean-code.git"
  },
  "bugs": {
    "url": "https://github.com/George2f/eslint-plugin-clean-code/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./rules.json": "./dist/rules.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^18.18.0 || ^20.9.0 || >=21.1.0"
  },
  "scripts": {
    "build": "tsup && node scripts/postbuild.mjs && node scripts/generate-catalog.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:dist": "node scripts/verify-dist.mjs",
    "lint": "tsc --noEmit && npm run build && eslint .",
    "prepublishOnly": "npm run lint && npm test && npm run verify:dist"
  },
  "peerDependencies": {
    "eslint": "^8.57.0 || ^9.0.0 || ^10.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/eslint-parser": "^8.0.7",
    "@types/node": "^22.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/rule-tester": "^8.0.0",
    "@typescript-eslint/utils": "^8.0.0",
    "eslint": "^9.0.0",
    "espree": "^10.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
